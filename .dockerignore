# Secrets and local configuration: never copied into an image
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Local environments, caches and generated data (the index is rebuilt inside the container)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
chroma_db/
*.corrupt-*/

# Not needed at runtime
.git/
.github/
.vscode/
.idea/
tests/
results/
docs/
presentation_output/
Dockerfile
.dockerignore
