# Copy this file to .env and adjust values if needed. Every supported setting is listed here.
# No API key or secret is needed to run the app. All values are validated at startup; an invalid value
# stops the app with "configuration is invalid" (details in the logs). Precedence:
# real environment variables > Streamlit secrets (top-level keys) > .env > defaults,
# except that AUTH_REQUIRED=true from any source wins (login is never silently switched off).

# Folder for the local ChromaDB vector index (generated data, rebuilt from the KB when missing/stale).
# On Streamlit Community Cloud the filesystem is ephemeral: the index is rebuilt after every restart.
CHROMA_DIR=./chroma_db

# Local embedding model (downloaded from Hugging Face on first run, ~90 MB) and its pinned revision
# (the commit used for all recorded evaluations). Leave the revision empty to follow the latest version.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Answer generator: "template" = rule-based, no LLM (the only supported value)
GENERATOR=template

# Retrieval settings (calibrated with: python -m scripts.calibrate_retrieval)
# TOP_K: 1-20. Thresholds: 0-1, and LOW must be lower than HIGH.
TOP_K=3
HIGH_CONFIDENCE_THRESHOLD=0.45
LOW_CONFIDENCE_THRESHOLD=0.30

# Logging: DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stderr and never contain query text.
LOG_LEVEL=INFO

# Per-browser-session rate limit: RATE_LIMIT_REQUESTS requests per RATE_LIMIT_WINDOW_SECONDS.
# Not a global or per-IP limit (that needs a reverse proxy / gateway, see OPERATIONS.md).
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# true = only users logged in through OIDC may use the app. Requires the [auth] section in
# .streamlit/secrets.toml (see .streamlit/secrets.toml.example). If true but not configured, the app
# is locked for everyone (fails closed).
AUTH_REQUIRED=false
