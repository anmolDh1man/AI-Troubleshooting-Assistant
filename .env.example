# Copy this file to .env and adjust values if needed.
# No API key is required for the current version.

# Local embedding model (downloaded from Hugging Face on first run, ~90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Answer generator: "template" = rule-based, no LLM (current default)
# Future options could be added here, e.g. "ollama" or a hosted LLM provider.
GENERATOR=template

# Retrieval settings (threshold will be calibrated in Phase 2)
TOP_K=3
SIMILARITY_THRESHOLD=0.40

# Example placeholder for a future LLM integration (leave empty):
# LLM_API_KEY=
