# TEMPLATE ONLY: every value below is a placeholder. Copy to .streamlit/secrets.toml (git-ignored) or paste
# into the Streamlit Community Cloud "Secrets" settings, and replace the placeholders with values from
# your identity provider. Never commit the real file.

# Optional: any setting from .env.example can also be given here as a top-level key.
# Real environment variables take precedence over these, except AUTH_REQUIRED = true, which always wins.
# If this file exists but has a syntax error, the app refuses to start (it never falls back to open mode).
# Keep credentials inside sections such as [auth]: Streamlit exports top-level values to the environment.
AUTH_REQUIRED = true
LOG_LEVEL = "INFO"

# Streamlit built-in OIDC login (st.login). Register this app with your OIDC provider
# (e.g. Microsoft Entra ID, Google, Okta, Auth0) and use its values.
[auth]
# Must end with /oauth2callback and match the redirect URI registered with the provider.
redirect_uri = "http://localhost:8501/oauth2callback"
# Long random string used to sign the login cookie, e.g. python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_CLIENT_ID"
client_secret = "REPLACE_WITH_CLIENT_SECRET"
server_metadata_url = "https://REPLACE_WITH_YOUR_PROVIDER/.well-known/openid-configuration"
